<Window x:Class="Civil3DDataExport.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Civil3DDataExport.Views"
             mc:Ignorable="d" 
             SizeToContent="Height"
             Width="300">
    <StackPanel>
        <TabControl>
            <TabItem Header="Alignment">
                <StackPanel>
                    <Label Content="Select Alignment:" Margin="2" />
                    <ComboBox ItemsSource="{Binding Alignments}" 
                          SelectedItem="{Binding SelectedAlignment}" 
                          DisplayMemberPath="Name" 
                          Margin="2" />

                    <Label Content="Select Profile: " Margin="2"/>
                    <ComboBox ItemsSource="{Binding Profiles}" 
                          SelectedItem="{Binding SelectedProfile}" 
                          DisplayMemberPath="Name" 
                          Margin="2" />

                    <Label Content="Step"/>
                    <TextBox Text="{Binding Step}" Margin="2" />

                    <Label Content="Start Station"/>
                    <TextBox Text="{Binding StartStation}" Margin="2" />

                    <Label Content="End Station"/>
                    <TextBox Text="{Binding EndStation}" Margin="2" />

                    <Label Content="Horizontal Offset"/>
                    <TextBox Text="{Binding PlanOffset}" Margin="2" />

                    <Label Content="Vertical Offset"/>
                    <TextBox Text="{Binding VerticalOffset}" Margin="2" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Content="Export Data" 
                Command="{Binding ExportCommand}" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom" 
                Margin="10" />

    </StackPanel>
</Window>
